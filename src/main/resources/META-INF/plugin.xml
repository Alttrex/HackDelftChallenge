<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.alttrex.hackdelftchallenge</id>
    <name>DevPet</name>
    <vendor>alttrex</vendor>
    <description><![CDATA[
        <p><b>DevPet</b> — A gamified IDE pet that lives in your IntelliJ Tool Window!</p>
        <p>Your virtual pet starts as an egg and evolves as you write code. Set a daily LOC goal, feed your pet with human-typed code, and watch it grow. Beware: AI-generated or pasted code makes it sick! When you build, the pet eats your code and poops out build artifacts. Meet your daily quota to earn DevCoins and buy cosmetics from the shop.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" supportsK1="true"/>
    </extensions>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- DevPet Tool Window -->
        <toolWindow factoryClass="com.github.alttrex.hackdelftchallenge.toolWindow.DevPetToolWindowFactory"
                    id="DevPet"
                    anchor="right"
                    icon="AllIcons.Nodes.Favorite"/>

        <!-- Code tracker startup activity -->
        <postStartupActivity implementation="com.github.alttrex.hackdelftchallenge.listeners.CodeTrackerRegistrar"/>

        <!-- Achievement / detection notifications -->
        <notificationGroup id="DevPet Notifications" displayType="BALLOON"/>
    </extensions>

    <projectListeners>
        <!-- Build/run execution listener -->
        <listener class="com.github.alttrex.hackdelftchallenge.listeners.BuildHook"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>
</idea-plugin>
